  "type": {
   "rule": "cylgate",
   "members": [
    "type_v3_B",
    "type_inscale_v2",
    "type_v4",
    "type_hollow"
   ],
   "cylinder_threshold": 0.7,
   "description": "cylinder iff mean P(cylinder) of type_v4+type_hollow >= 0.7, else box/sphere from mean(type_v3_B, type_inscale_v2); take the top-2 and let the downstream fit grade prune",
   "pooled_accuracy": 0.9608,
   "pooled_top2": 0.9804,
   "per_set": {
    "test": 0.9625,
    "test_carve": 0.99,
    "test_ff": 0.9775,
    "test_mixed": 0.98,
    "test_cyl": 0.885,
    "test_hollow": 0.97
   },
   "gate": 0.994,
   "gate_coverage": 0.487,
   "alternative": {
    "id": "mean_all5",
    "pooled_accuracy": 0.9513,
    "top2": 0.9929,
    "gate": 0.695,
    "note": "best box/sphere accuracy, but test_cyl only 0.765"
   },
   "g0": "fails against the per-set specialists (no combination beats B on box/sphere AND hollow/v4 on cylinders); passes vs the best pooled single net (type_hollow) on 4 of 6 sets"
  }
 },
